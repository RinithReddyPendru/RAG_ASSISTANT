{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/graph/path", "destination": "/api/graph" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}

